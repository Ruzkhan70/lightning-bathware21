rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuth() {
      return request.auth != null;
    }
    
    // Check if the authenticated user is an admin
    // This checks if there's a document in admins/{uid} with role == "admin"
    function isAdmin() {
      return isAuth() && 
             get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "admin";
    }
    
    // System collection - admin only
    match /system/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Admins collection - only admins can manage
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow create: if isAuth() && request.auth.uid == adminId;
      allow update, delete: if isAdmin() && request.auth.uid == adminId;
    }
    
    // Store data (products, profile, assets, content, categories) - public read, admin write
    match /storeData/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Admin credentials - admin only
    match /adminCredentials/{document=**} {
      allow read, write: if isAdmin();
    }
    
    // Admin login logs - anyone can create (for logging), admin read
    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuth();
      allow update, delete: if isAdmin();
    }
    
    // Orders - public create (checkout), owner or admin read, admin update/delete
    match /orders/{orderId} {
      allow read: if isAdmin() || (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if true;
      allow update, delete: if isAdmin();
    }
    
    // Activity Logs - admin only
    match /activityLogs/{logId} {
      allow read, write: if isAdmin();
    }
    
    // Admin Device Sessions - admin only
    match /adminDeviceSessions/{sessionId} {
      allow read, write: if isAdmin();
    }
    
    // Invoices - owner or admin read, authenticated create (checkout), admin update/delete
    match /invoices/{invoiceId} {
      allow read: if isAdmin() || (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if isAuth();
      allow update, delete: if isAdmin();
    }
    
    // Messages - public create (contact form), admin read/update/delete
    match /messages/{messageId} {
      allow read, delete, update: if isAdmin();
      allow create: if true;
    }
    
    // Offers - public read, admin write
    match /offers/{offerId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Reviews - public read/create, admin update/delete
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }
    
    // Users - own read/create, admin or self update, admin delete
    match /users/{userId} {
      allow read: if isAuth() && request.auth.uid == userId;
      allow create: if true;
      allow update: if isAdmin() || (isAuth() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }
    
    // Wishlist - users can only access their own
    match /wishlist/{userId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }
    
    // Carts - users can only access their own
    match /carts/{userId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }
    
    // Code Rotation OTP - admin only
    match /codeRotationOtp/{otpId} {
      allow read, write: if isAdmin();
    }

    // Login Attempts - anyone can create (for logging), admin read
    match /loginAttempts/{attemptId} {
      allow read: if isAdmin();
      allow create: if isAuth();
      allow update, delete: if isAdmin();
    }

    // Blocked IPs - admin read/write, public read for login check
    match /blockedIps/{blockId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Security verification attempts - admin only
    match /securityAttempts/{attemptId} {
      allow read, write: if isAdmin();
    }
  }
}
