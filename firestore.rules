rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuth() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuth() && 
             get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "admin";
    }
    
    function noAdminExists() {
      return !exists(/databases/$(database)/documents/system/adminSetup);
    }
    
    match /system/adminSetup {
      allow read: if true;
      allow write: if isAdmin() || (isAuth() && noAdminExists());
    }
    
    match /system/{document} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    match /admins/{adminId} {
      allow read: if isAuth();
      allow create: if isAdmin() || (isAuth() && request.auth.uid == adminId && noAdminExists());
      allow update, delete: if isAdmin();
    }
    
    match /storeData/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /adminCredentials/{document=**} {
      allow read, write: if isAdmin();
    }
    
    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }
    
    match /orders/{orderId} {
      allow read: if isAdmin() || (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if true;
      allow update, delete: if isAdmin();
    }
    
    match /activityLogs/{logId} {
      allow read, write: if isAdmin();
    }
    
    match /adminDeviceSessions/{sessionId} {
      allow read, write: if isAdmin();
    }
    
    match /invoices/{invoiceId} {
      allow read: if isAdmin() || (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if isAuth();
      allow update, delete: if isAdmin();
    }
    
    match /messages/{messageId} {
      allow read, delete, update: if isAdmin();
      allow create: if true;
    }
    
    match /offers/{offerId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }
    
    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAdmin() || (isAuth() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }
    
    match /wishlist/{userId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }
    
    match /carts/{userId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }
    
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isAdmin();
    }

    match /codeRotationOtp/{otpId} {
      allow read, write: if isAdmin();
    }

    match /loginAttempts/{attemptId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /blockedIps/{blockId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /securityAttempts/{attemptId} {
      allow read, write: if isAdmin();
    }
  }
}
